 {
-   /* A no-op that SUCCEEDS, and the reason is the same as cpu_map's: the mapping belongs to the VA op, not to
-    * this call. Tearing it down here would unmap memory the GPU is still addressing. */
-   return bo.abo ? 0 : -EINVAL;
+   /* A no-op that SUCCEEDS for the BO's own mapping, and the reason is the same as cpu_map's: the mapping belongs
+    * to the VA op, not to this call. Tearing it down here would unmap memory the GPU is still addressing.
+    *
+    * A placed alias is this call's to undo, and it is undone into a RESERVATION, never a hole: the range is
+    * the caller's address space (Wine committed it before asking), which is what VK_MEMORY_UNMAP_RESERVE_BIT_EXT
+    * promises and what Wine's own free of the range expects to find. */
+   struct orbis_bo *obo = bo.abo;
+   if (!obo)
+      return -EINVAL;
+#if defined(__PS4__)
+   if (obo->alias_bytes)
+      orbis_alias_unmap(obo, "unmap");
+#endif
+   return 0;
